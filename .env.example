# رابط سيرفر اللارافيل (بدون /api في النهاية)
VITE_API_BASE_URL=http://127.0.0.1:8000

# ==========================================================================
# إعدادات Firebase Cloud Messaging (FCM) — إشعارات الويب
# اطلب من مسؤول Firebase قيم "Firebase SDK config" لتطبيق الويب (Web App)
# من Firebase Console -> Project Settings -> General -> Your apps -> Web app
# هذه القيم عامة (public) وآمنة للوضع في الفرونت، وليست أسراراً.
# ==========================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# مفتاح VAPID العام (Web Push certificate) من Firebase Console -> Cloud Messaging
VITE_FIREBASE_VAPID_KEY=
